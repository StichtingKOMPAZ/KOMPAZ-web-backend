{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAnyProxy": false,
    "ForwardLimit": 1
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "MagicLinkPermitLimit": 5,
    "MagicLinkWindowSeconds": 300,
    "SignInPermitLimit": 30,
    "SignInWindowSeconds": 300
  },
  "ConnectionStrings": {
    "KompazDb": "Host=localhost;Port=5433;Database=kompaz;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Issuer": "https://localhost:5001",
    "Audience": "https://localhost:5001",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60,
    "MagicLinkLifetimeMinutes": 30,
    "InvitationLifetimeDays": 7,
    "RefreshTokenSlidingLifetimeDays": 14,
    "RefreshTokenAbsoluteLifetimeDays": 90
  },
  "Email": {
    "FromAddress": "noreply@kompaz.local",
    "FromName": "KOMPAZ",
    "DefaultLanguage": "nl",
    "MagicLinkUrl": "http://localhost:5173/auth/callback?token={token}",
    "InvitationUrl": "http://localhost:5173/invitations/accept?token={token}",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": ""
    }
  },
  "Storage": {
    "ConnectionString": "",
    "ContainerName": "organization-logos",
    "LocalPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Swagger": false
}
