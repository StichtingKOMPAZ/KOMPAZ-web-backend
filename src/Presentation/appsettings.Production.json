{
  "Cors": {
    "AllowedOrigins": [
      "https://app.example.com"
    ]
  },
  "ConnectionStrings": {
    "KompazDb": "Data Source=/var/lib/kompaz/kompaz.db"
  },
  "Authentication": {
    "Issuer": "https://api.example.com",
    "Audience": "https://app.example.com",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60,
    "MagicLinkLifetimeMinutes": 15,
    "InvitationLifetimeDays": 7,
    "RefreshTokenSlidingLifetimeDays": 14,
    "RefreshTokenAbsoluteLifetimeDays": 90
  },
  "Email": {
    "FromAddress": "noreply@example.com",
    "FromName": "KOMPAZ",
    "MagicLinkUrl": "https://app.example.com/auth/callback?token={token}",
    "InvitationUrl": "https://app.example.com/invitations/accept?token={token}",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "Password": ""
    }
  },
  "Swagger": false
}
